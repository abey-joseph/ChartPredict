# Copy to data-pipeline/.env (never commit .env). Use ONE of the two methods.

# Option A — OAuth 2.0 (recommended by Longbridge). Create an OAuth client in the
# Longbridge developer portal with redirect URI http://localhost:60355/callback.
# First run opens a browser to log in; the token is cached in ~/.longbridge/.
LONGBRIDGE_CLIENT_ID=

# Option B — legacy API key (developer portal → app key / secret / access token).
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
